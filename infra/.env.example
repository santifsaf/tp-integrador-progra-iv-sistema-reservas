# Admin de Keycloak (consola en http://localhost:8081/admin, realm master)
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin

# OAuth App de GitHub (Settings > Developer settings > OAuth Apps)
# Authorization callback URL: http://localhost:8081/realms/seat-reservation/broker/github/endpoint
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secrets de los clients de cada microservicio (client credentials).
# Cualquier string sirve; el servicio usa el mismo valor para pedir su token.
AVAILABILITY_CLIENT_SECRET=availability-secret
BOOKING_CLIENT_SECRET=booking-secret
PAYMENT_CLIENT_SECRET=payment-secret
NOTIFICATIONS_CLIENT_SECRET=notifications-secret

# PostgreSQL de Availability (valores locales de ejemplo; reemplazar en entornos compartidos).
# Postgres de Availability (solo desarrollo local; los valores por defecto sirven).
AVAILABILITY_DB_USER=availability
AVAILABILITY_DB_PASSWORD=availability
AVAILABILITY_DB_NAME=availability
# Puerto del host para dotnet ef, los tests y clientes SQL; entre contenedores siempre es 5432.
AVAILABILITY_DB_PORT=5433

# Postgres de Booking (solo desarrollo local; los valores por defecto sirven).
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=booking
BOOKING_DB_NAME=booking
# Puerto del host para dotnet ef, los tests y clientes SQL; entre contenedores siempre es 5432.
BOOKING_DB_PORT=5432

# Postgres de Payment (solo desarrollo local; los valores por defecto sirven).
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment
PAYMENT_DB_NAME=payment
# Puerto del host para dotnet ef, las pruebas y clientes SQL; entre contenedores siempre es 5432.
PAYMENT_DB_PORT=5434

# Booking.Api en Docker (docker compose up --build booking-api).
# Connection string de Azure Service Bus: pegarla SOLO en infra/.env, nunca en este archivo.
BOOKING_BROKER_CONNECTION_STRING=
# Puertos del host para las 2 réplicas de la API de Booking.
BOOKING_API_PORTS=5200-5201
# Dirección de Payment vista desde el contenedor (por defecto, Payment corriendo en el host).
BOOKING_PAYMENT_ADDRESS=http://host.docker.internal:5300
