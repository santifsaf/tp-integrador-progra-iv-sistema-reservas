    "TopicName": "grupo5-booking-topic"
  },
  "Booking": {
    "BaseUrl": "http://booking-api:8080/"
  },
  "Keycloak": {
    "TokenEndpoint": "http://keycloak:8081/realms/seat-reservation/protocol/openid-connect/token",
    "ClientId": "availability"
  }
}
