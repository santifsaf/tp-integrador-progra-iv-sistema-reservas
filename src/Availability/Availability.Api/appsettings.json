{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Authority": "http://keycloak:8081/realms/seat-reservation",
    "Audience": "availability",
    "RequireHttpsMetadata": false,
    "ValidateIssuerSigningKey": true,
    "ValidateLifetime": true
