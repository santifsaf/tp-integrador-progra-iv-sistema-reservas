{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:8081/realms/seat-reservation",
    "Audience": "booking",
    "AllowedClientId": "availability"
  },
  "Payment": {
    "Address": "http://localhost:5300",
    "TokenEndpoint": "http://localhost:8081/realms/seat-reservation/protocol/openid-connect/token",
    "ClientId": "booking",
    "DeadlineSeconds": 5,
    "TokenTimeoutSeconds": 5
  },
  "Reservations": {
    "HoldDuration": "00:02:00",
    "ExpirationInterval": "00:00:30"
  },
  "Broker": {
    "Topic": "grupo5-booking-topic",
    "Subscription": "booking",
    "MaxConcurrentCalls": 4
  }
}
