{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:8081/realms/seat-reservation",
    "Audience": "booking",
    "AllowedClientId": "availability"
  },
  "Payment": {
    "Address": "http://localhost:5300",
    "TokenEndpoint": "http://localhost:8081/realms/seat-reservation/protocol/openid-connect/token",
    "ClientId": "booking",
    "DeadlineSeconds": 5,
    "TokenTimeoutSeconds": 5
  }
}
