{
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/seat-reservation",
    "MetadataAddress": "http://localhost:8081/realms/seat-reservation/.well-known/openid-configuration",
    "Audience": "payment",
    "RequireHttpsMetadata": false,
    "AllowedClients": [ "booking" ],
    "ClockSkewSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*"
}
